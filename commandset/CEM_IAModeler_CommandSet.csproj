<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>CEM_IAModeler_CommandSet</AssemblyName>
        <RootNamespace>CEM_IAModeler_CommandSet</RootNamespace>
        <UseWPF>true</UseWPF>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x64</PlatformTarget>
        <ImplicitUsings>true</ImplicitUsings>
        <!-- Host (CEM_RibbonUI) owns deployment; don't let Nice3point publish this to the
             Addins folder when built as a dependency. (Build.Tasks 3.x: DeployRevitAddin
             replaces the 2.x PublishAddinFiles property.) -->
        <DeployRevitAddin Condition="'$(CemRibbonHostBuild)' != 'true'">true</DeployRevitAddin>
        <DeployRevitAddin Condition="'$(CemRibbonHostBuild)' == 'true'">false</DeployRevitAddin>
        <Configurations>Debug R20;Debug R21;Debug R22;Debug R23;Debug R24;Debug R25;Debug R26</Configurations>
        <Configurations>$(Configurations);Release R20;Release R21;Release R22;Release R23;Release R24;Release R25;Release R26</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="$(Configuration.Contains('R20'))">
        <RevitVersion>2020</RevitVersion>
        <TargetFramework>net48</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R21'))">
        <RevitVersion>2021</RevitVersion>
        <TargetFramework>net48</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R22'))">
        <RevitVersion>2022</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>$(DefineConstants);REVIT2022_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R23'))">
        <RevitVersion>2023</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>$(DefineConstants);REVIT2022_OR_GREATER;REVIT2023_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R24'))">
        <RevitVersion>2024</RevitVersion>
        <TargetFramework>net48</TargetFramework>
        <DefineConstants>$(DefineConstants);REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R25'))">
        <RevitVersion>2025</RevitVersion>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <DefineConstants>$(DefineConstants);REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="$(Configuration.Contains('R26'))">
        <RevitVersion>2026</RevitVersion>
        <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
        <DefineConstants>$(DefineConstants);REVIT2022_OR_GREATER;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
    </PropertyGroup>

    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
        <StartArguments>/language ENG</StartArguments>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="Nice3point.Revit.Build.Tasks" Version="3.0.1" />
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
		<PackageReference Include="RevitMCPSDK" Version="$(RevitVersion).*" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="System.Net.Http" />
    </ItemGroup>

    <!-- The cem_* tools call the Cemengal add-ins' own code, so they change when the add-ins change:
         a rebuild of CEM_RibbonUI rebuilds the add-ins, this command set against them, and stages both.
         Couples this fork to the sibling CEM_RevitAPI checkout, as the plugin's CEM_RevitAuth reference
         already does. The copies that land in Commands\ have the identities CEM_RibbonUI loaded at
         startup, so they resolve to the instances already in Revit, not to second ones.
         GlobalPropertiesToRemove: built through CEM_RibbonUI this project gets CemRibbonHostBuild=true;
         passing it on would make MSBuild build each add-in a second time, alongside the ribbon's own build
         of it. CEM_RevitAPI has no Revit 2020 configuration, so R20 builds without the cem_* tools. -->
    <ItemGroup Condition="'$(RevitVersion)' != '2020'">
        <ProjectReference Include="..\..\..\CEM_RevitAPI\CEM_RevitAPI_Extended\CEM_RevitAPI_Extended.csproj" GlobalPropertiesToRemove="CemRibbonHostBuild" />
        <ProjectReference Include="..\..\..\CEM_RevitAPI\CEM_Rules\CEM_Rules.csproj" GlobalPropertiesToRemove="CemRibbonHostBuild" />
        <ProjectReference Include="..\..\..\CEM_RevitAPI\CEM_SwapManager\CEM_SwapManager.csproj" GlobalPropertiesToRemove="CemRibbonHostBuild" />
        <!-- cem_open_tool finds the Cemengal ribbon buttons through AdWindows (reference only; Revit ships it). -->
        <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitVersion).*" />
    </ItemGroup>
    <ItemGroup Condition="'$(RevitVersion)' == '2020'">
        <Compile Remove="**\Cemengal\**" />
    </ItemGroup>

    <!-- take_screenshot uses GDI (System.Drawing) to grab the Revit window.
         On net48 System.Drawing is a framework assembly; on net8-windows it ships
         in the System.Drawing.Common package (WPF alone doesn't bring it in). -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
      <Reference Include="System.Drawing" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
      <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    </ItemGroup>

    <!-- Skip the fork's own deploy when CEM_RibbonUI is the host: the host stages the
         command set into its own output under Commands\ and publishes it next to the plugin. -->
    <Target Name="DeployCommandSet" AfterTargets="Build" Condition="'$(CemRibbonHostBuild)' != 'true'">
        <PropertyGroup>
            <PluginAddInRoot>$(ProjectDir)..\plugin\bin\AddIn $(RevitVersion) $(Configuration)\CEM_IAModeler\</PluginAddInRoot>
            <CommandSetPluginDir>$(PluginAddInRoot)Commands\CEM_IAModeler_CommandSet\</CommandSetPluginDir>
            <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\CEM_IAModeler\Commands\CEM_IAModeler_CommandSet\</RevitAddinsDir>
        </PropertyGroup>

        <ItemGroup>
            <CommandSetBinaries Include="$(TargetDir)*.dll;$(TargetDir)*.pdb" />
            <CommandJsonFile Include="$(ProjectDir)..\command.json" />
        </ItemGroup>

        <!-- Always: Copy to plugin's AddIn output for release packaging -->
        <MakeDir Directories="$(CommandSetPluginDir)$(RevitVersion)" />
        <Copy SourceFiles="@(CommandSetBinaries)" DestinationFolder="$(CommandSetPluginDir)$(RevitVersion)\" />
        <Copy SourceFiles="@(CommandJsonFile)" DestinationFolder="$(CommandSetPluginDir)" />

        <!-- Debug only: Copy to Revit Addins folder for local development -->
        <MakeDir Directories="$(RevitAddinsDir)$(RevitVersion)" Condition="$(Configuration.Contains('Debug'))" />
        <Copy SourceFiles="@(CommandSetBinaries)" DestinationFolder="$(RevitAddinsDir)$(RevitVersion)\" Condition="$(Configuration.Contains('Debug'))" />
        <Copy SourceFiles="@(CommandJsonFile)" DestinationFolder="$(RevitAddinsDir)" Condition="$(Configuration.Contains('Debug'))" />
    </Target>

</Project>